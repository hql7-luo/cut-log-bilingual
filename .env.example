# Supabase Project Settings → API. Only the publishable/anon key belongs here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys. The provider routes also require a signed-in Supabase user.
USDA_API_KEY=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Optional. Restrict paid provider calls to one confirmed account email.
FITNESS_ALLOWED_EMAIL=

# Optional external-agent CRUD. Run supabase/agent.sql and register a token first.
FITNESS_AGENT_ENABLED=0
